const shareScreenButton =
  document.getElementById('shareScreen');

const shareScreenBottom =
  document.getElementById('shareScreenBottom');

const localVideo =
  document.getElementById('localVideo');

const status =
  document.getElementById('status');

const placeholder =
  document.getElementById('placeholder');

const audioStatus =
  document.getElementById('audioStatus');

let localStream = null;

async function startScreenShare() {
  try {
    status.textContent =
      'Solicitando captura de tela...';

    localStream =
      await navigator.mediaDevices.getDisplayMedia({
        video: true,
        audio: true
      });

    const audioTracks =
      localStream.getAudioTracks();

    console.log(
      '[ScreenRoom] Tracks capturadas:',
      localStream
        .getTracks()
        .map(
          track =>
            `${track.kind}: ${track.label}`
        )
    );

    console.log(
      '[ScreenRoom] Faixas de áudio:',
      audioTracks.length
    );

    localVideo.srcObject = localStream;

    placeholder.style.display = 'none';
    localVideo.style.display = 'block';

    if (audioTracks.length > 0) {
      status.textContent =
        'Tela + áudio capturados.';

      audioStatus.innerHTML =
        '<span style="background:#35d49a;box-shadow:0 0 10px rgba(53,212,154,.7)"></span> Áudio do sistema ativo';
    } else {
      status.textContent =
        'Tela capturada, mas sem áudio.';

      audioStatus.innerHTML =
        '<span></span> Sem áudio do sistema';
    }

    const videoTrack =
      localStream.getVideoTracks()[0];

    if (videoTrack) {
      videoTrack.addEventListener(
        'ended',
        () => {
          stopScreenShare();
        }
      );
    }

  } catch (error) {
    console.error(
      '[ScreenRoom] Erro:',
      error
    );

    status.textContent =
      'Captura cancelada ou indisponível.';
  }
}

function stopScreenShare() {
  if (!localStream) {
    return;
  }

  localStream
    .getTracks()
    .forEach(track => track.stop());

  localStream = null;

  localVideo.srcObject = null;
  localVideo.style.display = 'none';
  placeholder.style.display = 'flex';

  audioStatus.innerHTML =
    '<span></span> Áudio do sistema';

  status.textContent =
    'Sistema pronto.';
}

shareScreenButton.addEventListener(
  'click',
  startScreenShare
);

shareScreenBottom.addEventListener(
  'click',
  startScreenShare
);
